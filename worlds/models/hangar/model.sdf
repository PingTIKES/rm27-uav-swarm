<?xml version="1.0"?>
<sdf version="1.9">
  <!-- RM2027 机库简化模型（静态）。
       平台顶面 z=0.24m，低于 A* 占据带下限 0.35m，不进入占据栅格（可飞越）。
       真实机库内部 300x300x200mm 收纳 4 机，此处简化为 0.70x0.70m 平台 + 4 个槽位标记，
       中心白色标记供后续 D430i 视觉伺服对准。 -->
  <model name="hangar">
    <static>true</static>

    <link name="base">
      <collision name="base_col">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.40 0.40 0.20</size></box></geometry>
      </collision>
      <visual name="base_vis">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.40 0.40 0.20</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.30 0.30 0.34 1</diffuse>
        </material>
      </visual>

      <collision name="platform_col">
        <pose>0 0 0.22 0 0 0</pose>
        <geometry><box><size>0.70 0.70 0.04</size></box></geometry>
      </collision>
      <visual name="platform_vis">
        <pose>0 0 0.22 0 0 0</pose>
        <geometry><box><size>0.70 0.70 0.04</size></box></geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.65 0.65 0.68 1</diffuse>
        </material>
      </visual>

      <!-- 4 个降落槽位标记（纯视觉） -->
      <visual name="slot_1">
        <pose>0.24 0.24 0.2425 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.005</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="slot_2">
        <pose>-0.24 0.24 0.2425 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.005</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="slot_3">
        <pose>0.24 -0.24 0.2425 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.005</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="slot_4">
        <pose>-0.24 -0.24 0.2425 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.005</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <!-- 中心对位标记（纯视觉，供视觉伺服） -->
      <visual name="center_marker">
        <pose>0 0 0.2425 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
