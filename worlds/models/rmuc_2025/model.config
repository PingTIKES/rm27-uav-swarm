<?xml version="1.0"?>
<model>
  <name>rmuc_2025</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>SMBU PolarBear Robotics Team (rmu_gazebo_simulator)</name>
  </author>
  <description>
    RoboMaster 2025 超级对抗赛全场模型（网格），源自 SMBU-PolarBear
    rmu_gazebo_simulator/resource/models/rmuc_2025，仅将 link pose 的
    x/y 偏移清零（网格本身已按场地中心建模），保留 z=0.2 使地板位于 z=0。
  </description>
</model>
