<?xml version='1.0'?>
<!-- RMUC2025 全场网格模型（来源：SMBU-PolarBear rmu_gazebo_simulator）
     原始 link pose 为 "14.5 8 0.2 0 0 0"，其 x/y 偏移用于配合他们
     自己的出生点配置；网格实际已按场地中心建模（x ±14.58, y ±8.08，
     地板 z=-0.2），故此处只保留 z=0.2 抬升，使地板落在 z=0。 -->
<sdf version='1.6'>
  <model name='rmuc_2025'>
    <static>true</static>
    <link name='body'>
      <pose frame=''>0 0 0.2 0 0 0</pose>
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://rmuc_2025/meshes/rmuc_2025.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>model://rmuc_2025/meshes/rmuc_2025.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
