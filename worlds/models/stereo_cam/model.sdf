<?xml version="1.0" encoding="UTF-8"?>
<!--
  stereo_cam：前置双目相机模型（OpenVINS 仿真测试用）

  参数对齐实机 Intel RealSense D430i（VIO 模式，关闭深度流）：
    - 双目灰度 640x480 @ 30Hz，基线 50mm
    - 水平视场 87 度（fx=fy=337.22, cx=320, cy=240，理想无畸变）
    - 高斯图像噪声 stddev=0.007（模拟真实 CMOS 读出噪声）

  挂载注意（PX4 merge 模式的硬性要求）：
    被 merge 进载机模型的相机模型，link 名必须带模型名前缀
    （<link name='stereo_cam/base_link'>，与 PX4 官方 OakD-Lite 的
    <link name="OakD-Lite/base_link"> 一致）。若只叫 base_link，
    merge 进 x500 后会与机体的 base_link 重名，整个模型加载失败。

  像素格式注意：gz-sim 相机合法格式名为 L_INT8（8bit 灰度），
  不是 L8_INT8。非法格式名会导致相机创建失败，在 Garden/ogre2
  下可能直接使 gz-server 断言崩溃。

  安装关系（与 config/openvins_sim/kalibr_imucam_chain.yaml 严格对应）：
    - 相机挂点 = x500 base_link 系 (0.17, 0, -0.06)（机头前下方，
      避开旋翼视野与底板遮挡）
    - cam0 在机体右侧 y=-0.025，cam1 在左侧 y=+0.025
    - 传感器姿态 rpy=(-90, 0, -90)：Gazebo 相机光学系 z 前向/x 右/y 下，
      该旋转使镜头朝机头方向（base_link +x）

  话题（绝对话题，整个仿真只允许一架带双目的飞机，否则撞名）：
    /vio_cam0/image  /vio_cam1/image  （camera_info 在同名 ..../camera_info）
-->
<sdf version='1.9'>
  <model name='stereo_cam'>
    <link name='stereo_cam/base_link'>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1.0e-5</ixx>
          <iyy>1.0e-5</iyy>
          <izz>1.0e-5</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name='housing'>
        <geometry>
          <box><size>0.02 0.09 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <sensor name='cam0' type='camera'>
        <pose>0 -0.025 0 -1.5707963 0 -1.5707963</pose>
        <topic>/vio_cam0/image</topic>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>

      <sensor name='cam1' type='camera'>
        <pose>0 0.025 0 -1.5707963 0 -1.5707963</pose>
        <topic>/vio_cam1/image</topic>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
